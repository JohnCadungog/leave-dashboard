      "name": "Teams - New Request",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [680, 200],
      "parameters": {
        "method": "POST",
        "url": "={{ $credentials.teamsWebhookUrl }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Content-Type", "value": "application/json" }]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "body",
              "value": "={\n  \"@type\": \"MessageCard\",\n  \"@context\": \"https://schema.org/extensions\",\n  \"themeColor\": \"F59E0B\",\n  \"summary\": \"New leave request\",\n  \"title\": \"🔔 New Leave Request\",\n  \"sections\": [{\n    \"activityTitle\": \"{{ $json.body.employee_name }} requested leave\",\n    \"facts\": [\n      { \"name\": \"From\", \"value\": \"{{ $json.body.start_date }}\" },\n      { \"name\": \"To\",   \"value\": \"{{ $json.body.end_date }}\" },\n      { \"name\": \"Reason\", \"value\": \"{{ $json.body.reason }}\" }\n    ]\n  }],\n  \"potentialAction\": [{\n    \"@type\": \"OpenUri\",\n    \"name\": \"Open Dashboard\",\n    \"targets\": [{ \"os\": \"default\", \"uri\": \"{{ $env.APP_URL }}/dashboard\" }]\n  }]\n}"
            }
          ]
        }
      }
    },
    {
      "id": "respond-200-new",
      "name": "Respond 200 (New)",
