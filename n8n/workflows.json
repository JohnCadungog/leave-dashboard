{
  "meta": {
    "instanceId": "leave-dashboard-n8n",
    "description": "App → n8n (validates secret) → Power Automate (sends 1:1 Teams chat). Env vars required in n8n: WEBHOOK_SECRET, POWER_AUTOMATE_NEW_URL, POWER_AUTOMATE_DECISION_URL."
  },
  "nodes": [
    {
      "id": "webhook-new",
      "name": "Webhook - New Request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "leave-new",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "if-secret-new",
      "name": "IF - Valid Secret (New)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true },
          "conditions": [
            {
              "id": "secret-check",
              "leftValue": "={{ $json.headers['x-webhook-secret'] }}",
              "rightValue": "={{ $env.WEBHOOK_SECRET }}",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        }
      }
    },
    {
      "id": "respond-401-new",
      "name": "Respond 401 (New)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [680, 460],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{ \"error\": \"Unauthorized\" }",
        "options": { "responseCode": 401 }
      }
    },
    {
      "id": "powerautomate-new",
      "name": "Power Automate - Notify Manager",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [680, 200],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.POWER_AUTOMATE_NEW_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Content-Type", "value": "application/json" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"employee_name\":  \"{{ $json.body.employee_name }}\",\n  \"employee_email\": \"{{ $json.body.employee_email }}\",\n  \"leave_type\":     \"{{ $json.body.leave_type }}\",\n  \"start_date\":     \"{{ $json.body.start_date }}\",\n  \"end_date\":       \"{{ $json.body.end_date }}\",\n  \"reason\":         \"{{ $json.body.reason }}\",\n  \"request_id\":     \"{{ $json.body.request_id }}\",\n  \"dashboard_url\":  \"{{ $env.APP_URL }}/dashboard\"\n}"
      }
    },
    {
      "id": "respond-200-new",
      "name": "Respond 200 (New)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [900, 200],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{ \"ok\": true }",
        "options": { "responseCode": 200 }
      }
    },
    {
      "id": "webhook-decision",
      "name": "Webhook - Decision",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 700],
      "parameters": {
        "httpMethod": "POST",
        "path": "leave-decision",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "if-secret-decision",
      "name": "IF - Valid Secret (Decision)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 700],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true },
          "conditions": [
            {
              "id": "secret-check-2",
              "leftValue": "={{ $json.headers['x-webhook-secret'] }}",
              "rightValue": "={{ $env.WEBHOOK_SECRET }}",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        }
      }
    },
    {
      "id": "respond-401-decision",
      "name": "Respond 401 (Decision)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [680, 860],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{ \"error\": \"Unauthorized\" }",
        "options": { "responseCode": 401 }
      }
    },
    {
      "id": "powerautomate-decision",
      "name": "Power Automate - Notify Employee",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [680, 700],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.POWER_AUTOMATE_DECISION_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Content-Type", "value": "application/json" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"employee_name\":  \"{{ $json.body.employee_name }}\",\n  \"employee_email\": \"{{ $json.body.employee_email }}\",\n  \"leave_type\":     \"{{ $json.body.leave_type }}\",\n  \"start_date\":     \"{{ $json.body.start_date }}\",\n  \"end_date\":       \"{{ $json.body.end_date }}\",\n  \"decided_by\":     \"{{ $json.body.decided_by }}\",\n  \"status\":         \"{{ $json.body.status }}\",\n  \"request_id\":     \"{{ $json.body.request_id }}\",\n  \"dashboard_url\":  \"{{ $env.APP_URL }}/dashboard\"\n}"
      }
    },
    {
      "id": "respond-200-decision",
      "name": "Respond 200 (Decision)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [900, 700],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{ \"ok\": true }",
        "options": { "responseCode": 200 }
      }
    }
  ],
  "connections": {
    "Webhook - New Request": {
      "main": [[{ "node": "IF - Valid Secret (New)", "type": "main", "index": 0 }]]
    },
    "IF - Valid Secret (New)": {
      "main": [
        [{ "node": "Power Automate - Notify Manager", "type": "main", "index": 0 }],
        [{ "node": "Respond 401 (New)", "type": "main", "index": 0 }]
      ]
    },
    "Power Automate - Notify Manager": {
      "main": [[{ "node": "Respond 200 (New)", "type": "main", "index": 0 }]]
    },
    "Webhook - Decision": {
      "main": [[{ "node": "IF - Valid Secret (Decision)", "type": "main", "index": 0 }]]
    },
    "IF - Valid Secret (Decision)": {
      "main": [
        [{ "node": "Power Automate - Notify Employee", "type": "main", "index": 0 }],
        [{ "node": "Respond 401 (Decision)", "type": "main", "index": 0 }]
      ]
    },
    "Power Automate - Notify Employee": {
      "main": [[{ "node": "Respond 200 (Decision)", "type": "main", "index": 0 }]]
    }
  }
}
