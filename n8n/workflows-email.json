{
  "meta": {
    "instanceId": "leave-dashboard-n8n-email",
    "description": "LeaveDesk app -> n8n webhook -> validate secret -> send email notifications through Gmail/SMTP. Replace PASTE_WEBHOOK_SECRET_HERE, MANAGER_EMAIL_HERE, and configure the Send Email nodes with your SMTP/Gmail credential after import."
  },
  "nodes": [
    {
      "id": "webhook-new",
      "name": "Webhook - New Request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "leave-new",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      }
    },
    {
      "id": "if-secret-new",
      "name": "IF - Valid Secret (New)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 300],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true
          },
          "conditions": [
            {
              "id": "secret-check-new",
              "leftValue": "={{ $json.headers['x-webhook-secret'] }}",
              "rightValue": "PASTE_WEBHOOK_SECRET_HERE",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      }
    },
    {
      "id": "respond-401-new",
      "name": "Respond 401 (New)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [680, 460],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{ \"error\": \"Unauthorized\" }",
        "options": {
          "responseCode": 401
        }
      }
    },
    {
      "id": "email-new",
      "name": "Email - Notify Manager",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [680, 200],
      "parameters": {
        "fromEmail": "PASTE_YOUR_GMAIL_ADDRESS_HERE",
        "toEmail": "MANAGER_EMAIL_HERE",
        "subject": "=New leave request from {{ $json.body.employee_name }}",
        "emailFormat": "html",
        "html": "=<h2>New leave request submitted</h2>\n<p>A new leave request needs manager review.</p>\n<table>\n  <tr><td><strong>Employee</strong></td><td>{{ $json.body.employee_name }}</td></tr>\n  <tr><td><strong>Email</strong></td><td>{{ $json.body.employee_email }}</td></tr>\n  <tr><td><strong>Leave type</strong></td><td>{{ $json.body.leave_type }}</td></tr>\n  <tr><td><strong>Dates</strong></td><td>{{ $json.body.start_date }} to {{ $json.body.end_date }}</td></tr>\n  <tr><td><strong>Reason</strong></td><td>{{ $json.body.reason }}</td></tr>\n</table>\n<p>Open LeaveDesk to approve or reject this request.</p>",
        "options": {}
      }
    },
    {
      "id": "respond-200-new",
      "name": "Respond 200 (New)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [900, 200],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{ \"ok\": true }",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "webhook-decision",
      "name": "Webhook - Decision",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 700],
      "parameters": {
        "httpMethod": "POST",
        "path": "leave-decision",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      }
    },
    {
      "id": "if-secret-decision",
      "name": "IF - Valid Secret (Decision)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 700],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true
          },
          "conditions": [
            {
              "id": "secret-check-decision",
              "leftValue": "={{ $json.headers['x-webhook-secret'] }}",
              "rightValue": "PASTE_WEBHOOK_SECRET_HERE",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      }
    },
    {
      "id": "respond-401-decision",
      "name": "Respond 401 (Decision)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [680, 860],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{ \"error\": \"Unauthorized\" }",
        "options": {
          "responseCode": 401
        }
      }
    },
    {
      "id": "email-decision",
      "name": "Email - Notify Employee Decision",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [680, 700],
      "parameters": {
        "fromEmail": "PASTE_YOUR_GMAIL_ADDRESS_HERE",
        "toEmail": "={{ $json.body.employee_email }}",
        "subject": "=Your leave request was {{ $json.body.status }}",
        "emailFormat": "html",
        "html": "=<h2>Leave request decision</h2>\n<p>Hello {{ $json.body.employee_name }},</p>\n<p>Your leave request has been <strong>{{ $json.body.status }}</strong>.</p>\n<table>\n  <tr><td><strong>Leave type</strong></td><td>{{ $json.body.leave_type }}</td></tr>\n  <tr><td><strong>Dates</strong></td><td>{{ $json.body.start_date }} to {{ $json.body.end_date }}</td></tr>\n  <tr><td><strong>Decided by</strong></td><td>{{ $json.body.decided_by }}</td></tr>\n</table>\n<p>You can open LeaveDesk to view the updated request status.</p>",
        "options": {}
      }
    },
    {
      "id": "respond-200-decision",
      "name": "Respond 200 (Decision)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [900, 700],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{ \"ok\": true }",
        "options": {
          "responseCode": 200
        }
      }
    }
  ],
  "connections": {
    "Webhook - New Request": {
      "main": [
        [
          {
            "node": "IF - Valid Secret (New)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF - Valid Secret (New)": {
      "main": [
        [
          {
            "node": "Email - Notify Manager",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond 401 (New)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Email - Notify Manager": {
      "main": [
        [
          {
            "node": "Respond 200 (New)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Webhook - Decision": {
      "main": [
        [
          {
            "node": "IF - Valid Secret (Decision)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF - Valid Secret (Decision)": {
      "main": [
        [
          {
            "node": "Email - Notify Employee Decision",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond 401 (Decision)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Email - Notify Employee Decision": {
      "main": [
        [
          {
            "node": "Respond 200 (Decision)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
